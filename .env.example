# Base URL of the backend API that serves normalized event data
# (Cloudflare Worker in front of Supabase — see docs/decisions/0001-mcp-server-setup.md).
# Leave unset to run the frontend against no backend: the Events Feed page
# will show its "backend not connected" state rather than any mock data.
#
# Expected contract: GET {VITE_API_BASE_URL}/events?<query> -> FetchEventsResult
# (see src/lib/api/events.ts for the exact query params and response shape).
VITE_API_BASE_URL=
