# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
.wrangler/
.vite/

# Env
.env
.env.local
.env.*.local

# Wrangler local secrets (worker/.dev.vars holds SUPABASE_SERVICE_ROLE_KEY —
# a real credential, never to be committed; wrangler's own convention also
# uses .dev.vars.<environment> for per-environment overrides)
.dev.vars
.dev.vars.*

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Testing
coverage/

# Python (local MCP servers, tooling)
__pycache__/
*.pyc
.venv/
venv/

# Ruflo / claude-flow local runtime state (not shared, may contain machine-specific data)
.swarm/
.claude-flow/data/
.claude-flow/sessions/
.claude-flow/logs/
ruvector.db
*.db-shm
*.db-wal

# /graphify skill output -- generated cache/graph artifacts, not source
graphify-out/
